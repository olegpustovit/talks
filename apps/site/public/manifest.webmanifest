  "icons": [
    { "src": "/remote-icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/remote-icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "/remote-icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/remote-icon.svg", "sizes": "any", "type": "image/svg+xml" }
  ]
}
