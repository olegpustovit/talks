{
  "name": "Slides remote",
  "short_name": "Remote",
  "description": "Drive a talk from your phone: steps, slide jumps and a trackpad pointer.",
  "start_url": "/remote",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#080a0b",
